#!/bin/sh
# This repo is pullboard itself, so its hooks run the source in this checkout.
# The CLI times the whole hook and stops it after 120 s; the staged static check runs inside the hook process.
root=$(git rev-parse --show-toplevel)
PULLBOARD_HOOK_STATIC=packages/gate/src/io/changed/scripts/static.js exec node "$root/apps/cli/pullboard.js" hook pre-commit
