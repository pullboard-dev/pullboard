#!/bin/sh
# This repo is pullboard itself, so its hooks run the source in this checkout.
root=$(git rev-parse --show-toplevel)
node --experimental-vm-modules --disable-warning=ExperimentalWarning "$root/packages/gate/src/io/changed/scripts/static.js" --staged-hook || exit 1
exec node "$root/apps/cli/pullboard.js" hook pre-commit
