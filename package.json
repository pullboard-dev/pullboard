{
  "name": "pullboard",
  "version": "0.9.3",
  "description": "Pullboard, local-first: a work board, lanes, a spec and git hooks that live in your repo. Nothing ships until a second agent verifies it.",
  "license": "MIT",
  "author": "Corey Olson",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pullboard-dev/pullboard.git"
  },
  "bugs": {
    "url": "https://github.com/pullboard-dev/pullboard/issues"
  },
  "type": "module",
  "bin": {
    "pullboard": "apps/cli/pullboard.js"
  },
  "exports": {
    ".": "./apps/lib/index.js"
  },
  "files": [
    "packages",
    "apps",
    "skills",
    "docs",
    "!docs/**/*.test.js",
    "!*/*/tests/**",
    "CHANGELOG.md",
    "README.md",
    "LICENSE",
    "!*/*/journeys/**"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "keywords": [
    "pullboard",
    "ai-agents",
    "coding-agents",
    "multi-agent",
    "verification",
    "git-hooks",
    "local-first",
    "spec"
  ],
  "homepage": "https://pullboard.dev",
  "scripts": {
    "test": "node apps/cli/src/io/run/tests.js",
    "gate": "node packages/gate/tests/fixtures/budgets.js && node apps/cli/pullboard.js spec check && npm test",
    "hosted-shapes": "PULLBOARD_HOSTED_SHAPES=1 node apps/cli/src/io/run/tests.js apps/cli/journeys/relay/hosted/shapes.test.js"
  }
}
