    <properties>
      <property name="date" value="2026-11-17T12:00:00"/>
      <property name="seed" value="0"/>
    </properties>
    <testcase classname="Elixir.MathTest" name="clause 1: adds two numbers" time="0.001"/>
    <testcase classname="Elixir.MathTest" name="clause 2: halves a number" time="0.002">
      <failure message="Assertion with == failed&#10;code:  assert half(4) == 2&#10;left:  1&#10;right: 2">test/math_test.exs:9</failure>
    </testcase>
    <testcase classname="Elixir.MathTest" name="clause 3: later" time="0.000">
      <skipped/>
    </testcase>
  </testsuite>
</testsuites>
