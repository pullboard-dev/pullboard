    <testcase classname="example.com/m/pkg" name="clause 2: halves a number" time="0.002">
      <failure message="Failed" type="">    add_test.go:14: half(4) = 1, want 2</failure>
    </testcase>
    <testcase classname="example.com/m/pkg" name="clause 3: later" time="0.000">
