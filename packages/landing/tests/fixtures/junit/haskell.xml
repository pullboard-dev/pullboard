    <testcase classname="Calc" name="clause 2: halves a number" time="0.002">
      <failure message="expected: 2 but got: 1">expected: 2
 but got: 1</failure>
    </testcase>
    <testcase classname="Calc" name="clause 3: later" time="0.000">
      <skipped/>
    </testcase>
  </testsuite>
</testsuites>
